shared: &shared
  user: ubuntu
  ssh_key: ~/.ssh/id_rsa
  # ssh_known_hosts_file: ~/.ssh/known_hosts
  listen_port: 51820
  verify_host_key: true
  # Optional mesh DNS (dnsmasq)
  # dns:
  #   enabled: true
  #   provider: dnsmasq
  #   domain: mesh.internal
  #   interface: wg0
  #   servers:
  #     - app-us-1
  #     - app-eu-1
  #   # Auto-generate <node>.mesh.internal records for every node (default: true)
  #   auto_records: true
  #   # Extra records (values can be IPs or node names)
  #   records:
  #     db-primary.mesh.internal:
  #       - db-primary
  #       - db-standby-1
  #     db-replica.mesh.internal:
  #       - db-standby-1

development:
  <<: *shared
  nodes:
    dev1:
      host: localhost
      # ssh_port: 2222            # Optional per-node SSH port
      # ssh_user: deploy          # Optional per-node SSH user
      # jump_host: existing-node  # Optional node name used as an SSH jump host
      # listen_port: 51821        # Optional per-node WireGuard port
      mesh_ip: 10.8.0.10
      label: local

